{
  "note_me": {
    "type": "object",
    "description": "Internal note that the model writes to itself for tracking thoughts and reminders",
    "properties": {
      "content": {
        "type": "string",
        "description": "The content of the note to self"
      },
      "priority": {
        "type": "string",
        "enum": ["low", "medium", "high"],
        "description": "Priority level of this note"
      },
      "timestamp": {
        "type": "string",
        "format": "date-time",
        "description": "When this note was created"
      },
      "context": {
        "type": "string",
        "description": "Optional context about what triggered this note"
      }
    },
    "required": ["content", "priority", "timestamp"]
  },

  "memory": {
    "type": "object",
    "description": "Memory storage for both short-term and long-term information",
    "properties": {
      "key": {
        "type": "string",
        "description": "Unique identifier for this memory"
      },
      "value": {
        "type": "string",
        "description": "The actual memory content"
      },
      "type": {
        "type": "string",
        "enum": ["short_term", "long_term"],
        "description": "Whether this is a short-term or long-term memory"
      },
      "timestamp": {
        "type": "string",
        "format": "date-time",
        "description": "When this memory was created"
      },
      "tags": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Optional tags for categorizing memories"
      },
      "importance": {
        "type": "number",
        "minimum": 0,
        "maximum": 10,
        "description": "Importance score from 0-10"
      }
    },
    "required": ["key", "value", "type", "timestamp"]
  },

  "next_action": {
    "type": "object",
    "description": "Defines the next action the model should take, including self-prompting",
    "properties": {
      "action": {
        "type": "string",
        "description": "The specific action to take next"
      },
      "reasoning": {
        "type": "string",
        "description": "Explanation of why this action is being taken"
      },
      "self_prompt": {
        "type": "string",
        "description": "A message the model sends back to itself to continue the conversation and prevent stopping"
      },
      "timestamp": {
        "type": "string",
        "format": "date-time",
        "description": "When this action was determined"
      },
      "expected_outcome": {
        "type": "string",
        "description": "What the model expects to achieve with this action"
      },
      "dependencies": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Any dependencies or prerequisites for this action"
      }
    },
    "required": ["action", "reasoning", "self_prompt", "timestamp"]
  },

  "tool_call": {
    "type": "object",
    "description": "Structured format for tool calls from the models",
    "properties": {
      "tool_name": {
        "type": "string",
        "description": "Name of the tool being called"
      },
      "parameters": {
        "type": "object",
        "description": "Parameters to pass to the tool"
      },
      "reason": {
        "type": "string",
        "description": "Why this tool is being called"
      },
      "timestamp": {
        "type": "string",
        "format": "date-time"
      }
    },
    "required": ["tool_name", "parameters", "reason", "timestamp"]
  },

  "conversation_state": {
    "type": "object",
    "description": "Overall state of the conversation from the model's perspective",
    "properties": {
      "phase": {
        "type": "string",
        "enum": ["greeting", "information_gathering", "problem_solving", "clarification", "conclusion"],
        "description": "Current phase of the conversation"
      },
      "user_intent": {
        "type": "string",
        "description": "Model's understanding of what the user wants"
      },
      "confidence": {
        "type": "number",
        "minimum": 0,
        "maximum": 1,
        "description": "Confidence level in understanding (0-1)"
      },
      "pending_questions": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Questions the model still needs to ask"
      },
      "timestamp": {
        "type": "string",
        "format": "date-time"
      }
    },
    "required": ["phase", "user_intent", "confidence", "timestamp"]
  }
}
